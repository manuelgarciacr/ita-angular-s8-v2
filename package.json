{
    "name": "ita-angular-s8-v2",
    "version": "1.0.1",
    "author": {
        "name": "Manuel García Criado"
    },
    "license": "MIT",
    "private": false,
    "scripts": {
        "ng": "ng",
        "start": "ng serve -c development -o",
        "build": "ng build",
        "build-prod": "ng build --configuration production --base-href /ita-angular-s8-v2/",
        "watch": "ng build --watch --configuration development",
        "audit:table": "npm audit --json | jq -r '.vulnerabilities | to_entries[] | . as $v | [\"\\(.key)  \\($v.value.range)\", \"Severity: \\($v.value.severity)\", (if $v.value.fixAvailable == false then \"No fix available\" elif $v.value.fixAvailable == true then \"fix available via `npm audit fix`\" else \"fix available via `npm audit fix --force`\\nWill install \\($v.value.fixAvailable.name)@\\($v.value.fixAvailable.version)\\(if $v.value.fixAvailable.isSemVerMajor then \", which is a breaking change\" else \"\" end)\" end)] | .[]'",
        "deploy": "find /mnt/vps/ita-angular-s8-v2 -mindepth 1 -delete; cp -r dist/ita-angular-s8-v2/. /mnt/vps/ita-angular-s8-v2",
        "test": "CHROME_BIN=/snap/bin/brave ng test --watch=false --browsers=ChromeHeadless",
        "test:ci": "CHROME_BIN=/snap/bin/brave ng test --watch=false --browsers=ChromeHeadless"
    },
    "browser": {
        "crypto": false
    },
    "dependencies": {
        "@angular/animations": "16.2.12",
        "@angular/cdk": "16.2.12",
        "@angular/common": "16.2.12",
        "@angular/compiler": "16.2.12",
        "@angular/core": "16.2.12",
        "@angular/forms": "16.2.12",
        "@angular/material": "16.2.12",
        "@angular/platform-browser": "16.2.12",
        "@angular/platform-browser-dynamic": "16.2.12",
        "@angular/router": "16.2.12",
        "@fullcalendar/angular": "^6.1.9",
        "@fullcalendar/core": "^6.1.9",
        "@fullcalendar/daygrid": "^6.1.9",
        "@fullcalendar/interaction": "^6.1.9",
        "@mapbox/mapbox-gl-draw": "1.5.2",
        "@ng-bootstrap/ng-bootstrap": "^15.1.1",
        "@popperjs/core": "^2.11.6",
        "@types/geojson": "^7946.0.13",
        "bcryptjs": "^2.4.3",
        "bootstrap": "^5.2.3",
        "mapbox-gl": "2.15.0",
        "ng2-charts": "^5.0.3",
        "ngx-mapbox-gl": "10.0.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "write-excel-file": "^1.4.27",
        "zone.js": "~0.13.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "16.2.12",
        "@angular/cli": "16.2.12",
        "@angular/compiler-cli": "16.2.12",
        "@angular/localize": "16.2.12",
        "@types/bcryptjs": "^2.4.5",
        "@types/jasmine": "~4.3.0",
        "@types/mapbox__mapbox-gl-draw": "^1.4.9",
        "@types/mapbox-gl": "^2.7.21",
        "@types/node": "^26.6.6",
        "jasmine-core": "~4.6.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "typescript": "~5.1.3"
    },
    "overrides": {
        "postcss": "8.5.28",
        "serialize-javascript": "7.1.2",
        "tar": "7.5.22",
        "piscina": "4.9.4"
    }
}
